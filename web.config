<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ARR reverse proxy to FastAPI on port 3683 -->
    <rewrite>
      <rules>
        <rule name="scraper-studio-api" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3683/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
